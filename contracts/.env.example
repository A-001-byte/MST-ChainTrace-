# Copy to .env and fill in. .env is gitignored — never commit it.
MST_RPC_URL=
# Intended MST testnet chainId; deploy-mst.ts aborts if the live chainId differs.
MST_CHAIN_ID=
DEPLOYER_PRIVATE_KEY=
# Block-explorer base URL for the demo script output, e.g. https://mstscan.example (no trailing slash)
MST_EXPLORER_URL=
# Optional deploy parameters (default: publisher = arbiter = deployer, demo only)
PUBLISHER_ADDRESS=
ARBITER_ADDRESS=
TREASURY_ADDRESS=
