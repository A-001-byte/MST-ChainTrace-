# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# MaxMind GeoLite2 license key (from https://www.maxmind.com/en/geolite2/signup)
GEOLITE2_LICENSE_KEY=your_license_key_here

# Optional: override default data paths
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed

# --- Console server (python -m src.webapp.server) ---------------------------
# The server reads these from the process environment (set them in your shell or
# service manager); it does not load this file by itself.
PORT=5000
# Signs investigator session cookies. Without it a random key is used per process,
# so everyone signs in again after a restart. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
CHAINTRACE_SECRET_KEY=

# --- On-chain verdict layer -------------------------------------------------
# Which contracts/deployments/<name>.json the console serves:
#   mst-testnet  the live MST testnet deployment (default)
#   localhost    a local `npx hardhat node` set up by contracts/scripts/local-demo.ts
CHAIN_NETWORK=mst-testnet
# Upstream RPC; the browser reaches it through the server's /api/chain/rpc relay.
CHAIN_RPC_URL=https://testnetrpc.mstblockchain.com
CHAIN_NAME=MST Testnet
CHAIN_EXPLORER_URL=
# Pin which exported epoch (outputs/mst/epoch_<N>.json) is served; default is the newest.
CHAIN_EPOCH=

# Publishing epochs needs contracts/.env (never committed) — see contracts/.env.example:
#   MST_RPC_URL, MST_CHAIN_ID, DEPLOYER_PRIVATE_KEY (must be the VerdictOracle publisher)
